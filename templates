<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Parking Management</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700&family=Barlow:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --asphalt: #26282c;
    --asphalt-2: #1c1d20;
    --paint: #f2efe4;
    --yellow: #f5c518;
    --muted: #8d9097;
    --red: #ff6b5e;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--asphalt-2); color: var(--paint);
    font-family: "Barlow", system-ui, sans-serif; line-height: 1.5;
  }
  main { max-width: 900px; margin: 0 auto; padding: 32px 20px 56px; }
  h1 {
    font-family: "Barlow Condensed", Impact, sans-serif; font-weight: 700;
    font-size: clamp(2.4rem, 8vw, 4rem); margin: 0; line-height: 1;
  }
  .sub { color: var(--muted); margin: 8px 0 28px; }
  .bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; margin-bottom: 20px; }
  .count { background: var(--asphalt); padding: 10px 18px; border-left: 4px solid var(--yellow); }
  .count b { font-family: "Barlow Condensed", sans-serif; font-size: 2rem; display: block; line-height: 1; }
  form { display: flex; gap: 8px; flex: 1; min-width: 260px; }
  input {
    flex: 1; padding: 12px 14px; font: inherit; font-size: 1.1rem; text-transform: uppercase;
    background: var(--asphalt); color: var(--paint); border: 2px solid var(--muted);
  }
  input:focus-visible, button:focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; }
  button {
    font-family: "Barlow Condensed", sans-serif; font-weight: 700; font-size: 1.1rem;
    padding: 12px 22px; border: 0; cursor: pointer; background: var(--yellow); color: #111;
  }
  #msg { min-height: 1.6em; margin: 0 0 16px; }
  #msg.err { color: var(--red); }
  .lot {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    background: var(--asphalt); padding: 24px 12px; border-top: 6px solid var(--yellow);
  }
  .bay {
    min-height: 150px; padding: 12px 8px; text-align: center;
    border-left: 3px solid var(--paint); border-right: 3px solid var(--paint); margin-left: -3px;
    display: flex; flex-direction: column; justify-content: space-between; align-items: center;
  }
  .num { font-family: "Barlow Condensed", sans-serif; font-size: 1.6rem; color: var(--muted); }
  .free .state { color: var(--muted); }
  .plate {
    background: var(--yellow); color: #111; font-family: "Barlow Condensed", sans-serif;
    font-weight: 700; font-size: 1.15rem; padding: 4px 10px; border-radius: 3px; word-break: break-all;
  }
  .since { font-size: .85rem; color: var(--muted); }
  .bay button { padding: 6px 14px; font-size: .95rem; background: var(--paint); }
  @media (prefers-reduced-motion: no-preference) { button { transition: transform .1s; } button:active { transform: scale(.96); } }
</style>
</head>
<body>
<main>
  <h1>Parking Management</h1>
  <p class="sub">Rate: {{ rate }} per hour (minimum 1 hour).</p>

  <div class="bar">
    <div class="count"><b id="free">0</b>free</div>
    <div class="count"><b id="used">0</b>occupied</div>
    <form id="park-form">
      <input id="plate" placeholder="Vehicle number, e.g. KA01AB1234" autocomplete="off" required>
      <button type="submit">Park vehicle</button>
    </form>
  </div>

  <p id="msg" role="status"></p>
  <section class="lot" id="lot" aria-label="Parking bays"></section>
</main>

<script>
const lot = document.getElementById("lot");
const msg = document.getElementById("msg");

function say(text, isError) {
  msg.textContent = text;
  msg.className = isError ? "err" : "";
}

function ago(iso) {
  const mins = Math.floor((Date.now() - new Date(iso)) / 60000);
  return mins < 60 ? mins + " min" : Math.floor(mins / 60) + " hr " + (mins % 60) + " min";
}

async function load() {
  const slots = await (await fetch("/api/slots")).json();
  lot.innerHTML = "";
  let used = 0;
  for (const s of slots) {
    const bay = document.createElement("div");
    bay.className = "bay " + (s.plate ? "taken" : "free");
    const num = document.createElement("div");
    num.className = "num"; num.textContent = s.id;
    bay.append(num);
    if (s.plate) {
      used++;
      const p = document.createElement("div"); p.className = "plate"; p.textContent = s.plate;
      const t = document.createElement("div"); t.className = "since"; t.textContent = ago(s.since);
      const b = document.createElement("button"); b.textContent = "Release";
      b.onclick = () => act("/api/release", { slot: s.id });
      bay.append(p, t, b);
    } else {
      const f = document.createElement("div"); f.className = "state"; f.textContent = "Free";
      bay.append(f);
    }
    lot.append(bay);
  }
  document.getElementById("used").textContent = used;
  document.getElementById("free").textContent = slots.length - used;
}

async function act(url, body) {
  const res = await fetch(url, {
    method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
  });
  const data = await res.json();
  say(data.error || data.message, !res.ok);
  load();
  return res.ok;
}

document.getElementById("park-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const input = document.getElementById("plate");
  if (await act("/api/park", { plate: input.value })) input.value = "";
});

load();
setInterval(load, 15000);
</script>
</body>
</html>
